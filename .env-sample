# Hermes dashboard
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_OIDC_SCOPES=openid profile email

# Public Hermes dashboard URL
HERMES_PUBLIC_URL=https://hermes.yourdomain.com
HERMES_DASHBOARD_OIDC_CLIENT_SECRET=YOUR OIDC CLLIEN SECRET HERE

# Microsoft Entra ID - tenant-specific OIDC issuer
HERMES_OIDC_ISSUER=https://login.microsoftonline.com/${TENANT ID}/v2.0

# Entra application registration
ENTRA_TENANT_ID=YOUR TENANT ID HERE
ENTRA_CLIENT_ID=YOUR APP REG CLIENT ID

# Container ports
HERMES_DASHBOARD_CONTAINER_PORT=9119
HERMES_GATEWAY_CONTAINER_PORT=8642

HERMES_DASHBOARD_BASIC_AUTH_USERNAME=YOUR USERNAME HERE
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=YOUR PASSWORD HERE
HERMES_DASHBOARD_BASIC_AUTH_SECRET=YOUR RANDOM SECRET HERE

